{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "4bros-alpha.vercel.app" }],
      "destination": "https://www.4bros.website/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "4bros-alpha.vercel.app" }],
      "destination": "https://www.4bros.website/:path*",
      "permanent": true
    }
  ]
}
